    {
      "id": "b1c2d3e4f5a60021",
      "type": "text",
      "x": -350,
      "y": 460,
      "width": 250,
      "height": 100,
      "text": "## 🟢 Insforge\nSQLite + pgvector\nSemantic search\n**Primary adapter**",
      "color": "1"
    },
    {
      "id": "b1c2d3e4f5a60022",
      "type": "text",
      "x": -50,
      "y": 460,
      "width": 250,
      "height": 100,
      "text": "## 🟡 Supabase\nRemote Postgres\nCross-device sync\n**Backup adapter**",
      "color": "2"
    },
    {
      "id": "b1c2d3e4f5a60023",
      "type": "text",
      "x": 250,
      "y": 460,
      "width": 250,
      "height": 100,
      "text": "## 🟢 SQLite\nLocal agent.db\nAlways available\n**Offline fallback**",
      "color": "4"
    },
    {
      "id": "b1c2d3e4f5a60030",
      "type": "group",
